{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "onelegstudios/laravel-shape",
    "description": "Shape the interface. Predictable UI components for Laravel and Livewire.",
    "keywords": [
        "laravel",
        "onelegstudios",
        "laravel-shape"
    ],
    "homepage": "https://github.com/onelegstudios/laravel-shape",
    "license": "MIT",
    "authors": [
        {
            "name": "Henrik Persson",
            "email": "henrik.persson@onelegstudios.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "blade-ui-kit/blade-icons": "^1.10",
        "illuminate/support": "^12.0||^13.0",
        "livewire/blaze": "^1.0.13"
    },
    "require-dev": {
        "blade-ui-kit/blade-heroicons": "^2.7",
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "mallardduck/blade-lucide-icons": "^2.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "blade-ui-kit/blade-heroicons": "The other icon set shape:install offers (^2.7), in outline, solid, mini and micro. Install it directly so you can swap it with plain composer remove.",
        "mallardduck/blade-lucide-icons": "The icon set config points at out of the box (^1.26). Any Blade Icons set works; install it directly so you can swap it with plain composer remove."
    },
    "autoload": {
        "psr-4": {
            "Onelegstudios\\Shape\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Onelegstudios\\Shape\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "bench": [
            "@php benchmarks/blaze.php"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Onelegstudios\\Shape\\ShapeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
